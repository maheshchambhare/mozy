<Rive version="1" kind="fragment">
    <!-- Moz, the Mozy sprout mascot, drawn from the 3D clay renders in public/mascot_emotions.
         Artboard 640x800. Every feature lives in its own Node, centred on its own origin, so the
         turnaround rig can slide, foreshorten and hide it later without touching the artwork. -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="640" height="900" name="Moz" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Design-time background, removed for the shipped file. -->
        <Fill name="Background">
            <SolidColor colorValue="FFF7F4EE" name="Color"/>
        </Fill>

        <!-- ===================== HEAD ===================== -->
        <!-- Root: origin on the ground line between the feet. The head keeps its artboard position (320, 380). -->
        <Node x="320" y="829" name="Root" id="0:200">
        <Node x="0" y="-449" name="Head" id="0:20">

            <!-- Sprout: a thick stub stem on the crown, two plump leaves branching from its top. -->
            <Node x="0" y="-162" name="Sprout" id="0:30">
                <!-- Left leaf, steep up-left -->
                <Node x="0" y="-34" rotation="-2.40" name="Leaf L" id="0:32">
                    <Shape name="Leaf L Shine" id="0:36">
                        <Ellipse x="88" y="-26" width="118" height="44" name="Path"/>
                        <Fill name="Fill">
                            <RadialGradient startX="88" startY="-26" endX="147" endY="-26" name="Gradient">
