                            </RadialGradient>
                        </Fill>
                        <Stroke thickness="2" name="Rim">
                            <SolidColor colorValue="CC3C2417" name="Color"/>
                        </Stroke>
                    </Shape>
                </Node>
                <!-- Stern brows (hidden until the mood rig uses them) -->
                <Shape x="-78" y="-58" rotation="0.22" hidden="true" name="Brow L" id="0:59">
                    <PointsPath name="Path">
                        <StraightVertex x="-36" y="0"/>
                        <StraightVertex x="36" y="0"/>
                    </PointsPath>
                    <Stroke thickness="13" cap="round" name="Stroke">
                        <SolidColor colorValue="FF2B160D" name="Color"/>
                    </Stroke>
                </Shape>
                <Shape x="78" y="-58" rotation="-0.22" hidden="true" name="Brow R" id="0:60">
                    <PointsPath name="Path">
                        <StraightVertex x="-36" y="0"/>
                        <StraightVertex x="36" y="0"/>
                    </PointsPath>
                    <Stroke thickness="13" cap="round" name="Stroke">
