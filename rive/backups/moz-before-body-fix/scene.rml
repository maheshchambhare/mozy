<Rive version="1" kind="fragment">
    <!-- Moz, the Mozy sprout mascot, drawn from the 3D clay renders in public/mascot_emotions.
         Artboard 640x800. Every feature lives in its own Node, centred on its own origin, so the
         turnaround rig can slide, foreshorten and hide it later without touching the artwork. -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="640" height="800" name="Moz" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Design-time background, removed for the shipped file. -->
        <Fill name="Background">
            <SolidColor colorValue="FFF7F4EE" name="Color"/>
        </Fill>

        <!-- ===================== HEAD ===================== -->
        <Node x="320" y="380" name="Head" id="0:20">

            <!-- Sprout: a thick stub stem on the crown, two plump leaves branching from its top. -->
            <Node x="0" y="-162" name="Sprout" id="0:30">
                <!-- Left leaf, steep up-left -->
                <Node x="0" y="-34" rotation="-2.40" name="Leaf L" id="0:32">
                    <Shape name="Leaf L Shine" id="0:36">
                        <Ellipse x="88" y="-26" width="118" height="44" name="Path"/>
                        <Fill name="Fill">
                            <RadialGradient startX="88" startY="-26" endX="147" endY="-26" name="Gradient">
                                <GradientStop colorValue="6EFFFFFF" position="0"/>
                                <GradientStop colorValue="00FFFFFF" position="1"/>
                            </RadialGradient>
                        </Fill>
                    </Shape>
                    <Shape name="Leaf L Vein" id="0:37">
                        <PointsPath name="Path">
                            <StraightVertex x="10" y="0"/>
                            <CubicMirroredVertex x="86" y="3" rotation="0" distance="38"/>
                            <StraightVertex x="152" y="0"/>
                        </PointsPath>
                        <Stroke thickness="3" cap="round" name="Stroke">
                            <SolidColor colorValue="995D9D2A" name="Color"/>
                        </Stroke>
                    </Shape>
                    <Shape name="Leaf L Body" id="0:34">
                        <PointsPath isClosed="true" name="Path">
                            <CubicMirroredVertex x="0" y="0" rotation="-1.5708" distance="30"/>
                            <CubicMirroredVertex x="86" y="-66" rotation="0" distance="50"/>
                            <CubicMirroredVertex x="167" y="0" rotation="1.5708" distance="40"/>
                            <CubicMirroredVertex x="86" y="66" rotation="3.1416" distance="50"/>
                        </PointsPath>
                        <Fill name="Fill">
                            <RadialGradient startX="78" startY="-28" endX="238" endY="-28" name="Gradient">
                                <GradientStop colorValue="FFC8EC60" position="0"/>
                                <GradientStop colorValue="FF92C941" position="0.5"/>
                                <GradientStop colorValue="FF4C9527" position="1"/>
                            </RadialGradient>
                        </Fill>
                    </Shape>
                </Node>

                <!-- Right leaf, nearly level up-right -->
                <Node x="0" y="-34" rotation="-0.35" name="Leaf R" id="0:33">
                    <Shape name="Leaf R Shine" id="0:38">
                        <Ellipse x="84" y="-24" width="112" height="40" name="Path"/>
                        <Fill name="Fill">
                            <RadialGradient startX="84" startY="-24" endX="140" endY="-24" name="Gradient">
                                <GradientStop colorValue="6EFFFFFF" position="0"/>
                                <GradientStop colorValue="00FFFFFF" position="1"/>
                            </RadialGradient>
                        </Fill>
                    </Shape>
                    <Shape name="Leaf R Vein" id="0:39">
                        <PointsPath name="Path">
                            <StraightVertex x="10" y="0"/>
                            <CubicMirroredVertex x="82" y="3" rotation="0" distance="36"/>
                            <StraightVertex x="146" y="0"/>
                        </PointsPath>
                        <Stroke thickness="3" cap="round" name="Stroke">
                            <SolidColor colorValue="995D9D2A" name="Color"/>
                        </Stroke>
                    </Shape>
                    <Shape name="Leaf R Body" id="0:35">
                        <PointsPath isClosed="true" name="Path">
                            <CubicMirroredVertex x="0" y="0" rotation="-1.5708" distance="28"/>
                            <CubicMirroredVertex x="82" y="-60" rotation="0" distance="48"/>
                            <CubicMirroredVertex x="160" y="0" rotation="1.5708" distance="38"/>
