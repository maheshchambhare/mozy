                <Fill name="Chin Shadow">
                    <LinearGradient startX="0" startY="20" endX="0" endY="174" name="Gradient">
                        <GradientStop colorValue="00C8A276" position="0"/>
                        <GradientStop colorValue="70C49C70" position="1"/>
