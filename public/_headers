# Response headers for Cloudflare static assets (https://developers.cloudflare.com/workers/static-assets/headers/).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Hashed JS and CSS from Vite (vite.config.ts assetsDir): the name changes with the content, so cache for a year.
/_app/*
  Cache-Control: public, max-age=31536000, immutable

# Images, badges and the share banner keep their names, so browsers recheck them daily.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Preview addresses on workers.dev stay out of search results; only mozy.mcrudra.com is indexed.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
