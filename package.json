{
  "name": "mozy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "cf:preview": "npm run build && wrangler pages dev --port 8788",
    "cf:deploy": "npm run build && wrangler pages deploy",
    "test:content": "node scripts/check-blog-content.mjs",
    "og:render": "node scripts/og/render.mjs h --out public/assets --name og-banner --format jpeg --quality 90",
    "mcs:check": "python3 \"${MCS_HOME:-$HOME/.claude/skills/mcs}/scripts/mcs.py\" check --site .",
    "mcs:gate": "python3 \"${MCS_HOME:-$HOME/.claude/skills/mcs}/scripts/mcs.py\" gate --site ."
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "posthog-js": "^1.438.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
